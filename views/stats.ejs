<!-- Stats Hint -->
<div class="hint mb-1" style="color: var(--text-muted); font-size: 13px;">
    <i class="ti ti-info-circle"></i> <%= t('stats.hint') || 'Данные обновляются каждые 5 минут. Выберите период для просмотра истории.' %>
</div>

<!-- Stats Summary -->
<div class="stats-grid stats-summary-grid">
    <div class="stat-card stat-online-now">
        <div class="stat-header">
            <span class="stat-icon"><i class="ti ti-world"></i></span>
            <span class="stat-trend" id="onlineTrend">—</span>
        </div>
        <div class="stat-value" id="currentOnline"><%= summary.current.online %></div>
        <div class="stat-label"><%= t('stats.onlineNow') %></div>
    </div>
    
    <div class="stat-card stat-peak">
        <div class="stat-header">
            <span class="stat-icon"><i class="ti ti-trending-up"></i></span>
            <span class="stat-trend"><%= t('stats.last24h') %></span>
        </div>
        <div class="stat-value"><%= summary.peak24h %></div>
        <div class="stat-label"><%= t('stats.peakOnline') %></div>
    </div>
    
    <div class="stat-card stat-traffic-24h">
        <div class="stat-header">
            <span class="stat-icon"><i class="ti ti-chart-bar"></i></span>
            <span class="stat-trend"><%= t('stats.last24h') %></span>
        </div>
        <div class="stat-value"><%= formatTraffic(summary.traffic24h.total) %></div>
        <div class="stat-label"><i class="ti ti-arrow-up" style="color:var(--success)"></i> <%= formatTraffic(summary.traffic24h.tx) %> / <i class="ti ti-arrow-down" style="color:var(--info)"></i> <%= formatTraffic(summary.traffic24h.rx) %></div>
    </div>
    
    <div class="stat-card stat-nodes">
        <div class="stat-header">
            <span class="stat-icon"><i class="ti ti-server"></i></span>
            <span class="stat-trend"><%= t('stats.active') %></span>
        </div>
        <div class="stat-value"><%= summary.current.nodesOnline %><span class="stat-small">/<%= summary.current.nodesTotal %></span></div>
        <div class="stat-label"><%= t('stats.nodesOnline') %></div>
    </div>
</div>

<!-- Period Selector -->
<div class="period-selector">
    <button class="period-btn active" data-period="1h">1<%= t('stats.h') %></button>
    <button class="period-btn" data-period="6h">6<%= t('stats.h') %></button>
    <button class="period-btn" data-period="24h">24<%= t('stats.h') %></button>
    <button class="period-btn" data-period="7d">7<%= t('stats.d') %></button>
    <button class="period-btn" data-period="30d">30<%= t('stats.d') %></button>
</div>

<!-- Charts Grid -->
<div class="charts-grid">
    <!-- Online Users Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2><i class="ti ti-world"></i> <%= t('stats.onlineConnections') %></h2>
            <div class="chart-legend" id="onlineLegend"></div>
        </div>
        <div class="card-body chart-body">
            <canvas id="onlineChart"></canvas>
        </div>
    </div>
    
    <!-- Traffic Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2><i class="ti ti-chart-bar"></i> <%= t('stats.traffic') %></h2>
            <div class="traffic-totals" id="trafficTotals"></div>
        </div>
        <div class="card-body chart-body">
            <canvas id="trafficChart"></canvas>
        </div>
    </div>
</div>

<!-- Nodes Online Chart -->
<div class="card chart-card chart-card-wide mt-2">
    <div class="card-header">
        <h2><i class="ti ti-server"></i> <%= t('stats.nodesUsage') %></h2>
        <div class="header-actions">
            <select id="nodeSelector" class="filter-select">
                <option value="all"><%= t('stats.allNodes') %></option>
            </select>
        </div>
    </div>
    <div class="card-body chart-body chart-body-tall">
        <canvas id="nodesChart"></canvas>
    </div>
</div>

<!-- Nodes Traffic Chart -->
<div class="card chart-card chart-card-wide mt-2">
    <div class="card-header">
        <h2><i class="ti ti-arrows-transfer-down"></i> <%= t('stats.nodesTraffic') %></h2>
        <div class="header-actions">
            <select id="nodeTrafficSelector" class="filter-select">
                <option value="all"><%= t('stats.allNodes') %></option>
            </select>
        </div>
    </div>
    <div class="card-body chart-body chart-body-tall">
        <canvas id="nodesTrafficChart"></canvas>
    </div>
</div>

<!-- Nodes Table -->
<div class="card mt-2">
    <div class="card-header">
        <h2><i class="ti ti-table"></i> <%= t('stats.nodesStats') %></h2>
    </div>
    <div class="card-body no-padding">
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th><%= t('stats.node') %></th>
                        <th><%= t('stats.currentOnline') %></th>
                        <th><%= t('stats.avgOnline') %></th>
                        <th><%= t('stats.peakOnline') %></th>
                        <th><%= t('stats.tx') %></th>
                        <th><%= t('stats.rx') %></th>
                        <th><%= t('common.status') %></th>
                    </tr>
                </thead>
                <tbody id="nodesTableBody">
                    <tr><td colspan="7" class="text-center text-muted"><%= t('common.loading') %></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Users: who is where, with which app -->
<div class="card mt-2" id="usersCard">
    <div class="card-header">
        <h2><i class="ti ti-users"></i> <%= t('stats.usersTitle') %></h2>
        <div class="header-actions users-actions">
            <label class="users-toggle"><input type="checkbox" id="usersOnlineOnly"> <%= t('stats.usersOnlineOnly') %></label>
            <input type="search" id="usersSearch" class="users-search" placeholder="<%= t('common.search') %>">
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted users-desc"><%= t('stats.usersDesc') %></p>
        <div class="users-chips" id="usersSummary"></div>
    </div>
    <div class="card-body no-padding">
        <div class="table-wrapper">
            <table class="table users-table">
                <thead>
                    <tr>
                        <th><%= t('stats.user') %></th>
                        <th><%= t('stats.usersOnlineNow') %></th>
                        <th><%= t('stats.usersApps') %></th>
                        <th><%= t('stats.usersSubFetched') %></th>
                        <th><%= t('stats.usersAppLogin') %></th>
                        <th class="text-right"><%= t('stats.usersTraffic') %></th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    <tr><td colspan="6" class="text-center text-muted"><%= t('common.loading') %></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-2" id="usersMatrixCard">
    <div class="card-header">
        <h2><i class="ti ti-grid-dots"></i> <%= t('stats.usersMatrixTitle') %></h2>
    </div>
    <div class="card-body">
        <p class="text-muted users-desc"><%= t('stats.usersMatrixDesc') %></p>
    </div>
    <div class="card-body no-padding">
        <div class="table-wrapper users-matrix-wrap">
            <table class="table users-matrix" id="usersMatrix">
                <tbody><tr><td class="text-center text-muted"><%= t('common.loading') %></td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Server Load Section -->
<div class="charts-grid mt-2">
    <!-- CPU + Load Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2><i class="ti ti-cpu"></i> <%= t('stats.serverCpu') %></h2>
            <div class="chart-legend" id="hostCpuLegend"></div>
        </div>
        <div class="card-body chart-body">
            <canvas id="hostCpuChart"></canvas>
        </div>
    </div>

    <!-- Memory + RSS Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2><i class="ti ti-database"></i> <%= t('stats.serverMemory') %></h2>
            <div class="chart-legend" id="hostMemLegend"></div>
        </div>
        <div class="card-body chart-body">
            <canvas id="hostMemChart"></canvas>
        </div>
    </div>

    <!-- Disk usage Chart -->
    <div class="card chart-card">
        <div class="card-header">
            <h2><i class="ti ti-server-2"></i> <%= t('stats.serverDisk') %></h2>
            <div class="chart-legend" id="hostDiskLegend"></div>
        </div>
        <div class="card-body chart-body">
            <canvas id="hostDiskChart"></canvas>
        </div>
    </div>
</div>

<!-- Requests per minute Chart -->
<div class="card chart-card chart-card-wide mt-2">
    <div class="card-header">
        <h2><i class="ti ti-activity"></i> <%= t('stats.serverRpm') %></h2>
        <div class="chart-legend" id="hostRpmLegend"></div>
    </div>
    <div class="card-body chart-body">
        <canvas id="hostRpmChart"></canvas>
    </div>
</div>

<!-- VPN Clients Section -->
<div class="card mt-2" id="clientsCard">
    <div class="card-header">
        <h2><i class="ti ti-device-mobile"></i> <%= t('stats.clientsTitle') %></h2>
        <div class="header-actions">
            <span class="stat-trend text-muted" id="clientsTotal"></span>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted" style="font-size:13px; margin-bottom:16px;"><%= t('stats.clientsDesc') %></p>
        <div class="clients-layout">
            <div class="clients-chart-wrap">
                <canvas id="clientsChart"></canvas>
            </div>
            <div class="clients-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th><%= t('stats.clientName') %></th>
                            <th class="text-right"><%= t('stats.uniqueUsers') %></th>
                            <th class="text-right"><%= t('stats.percentage') %></th>
                        </tr>
                    </thead>
                    <tbody id="clientsTableBody">
                        <tr><td colspan="3" class="text-center text-muted"><%= t('common.loading') %></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="toast" class="toast"></div>

<style>
.stats-summary-grid {
    grid-template-columns: repeat(4, 1fr);
}

.stat-small {
    font-size: 0.5em;
    color: var(--text-muted);
}

.period-selector {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    background: var(--bg-secondary);
    padding: 8px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    width: fit-content;
}

.period-btn {
    padding: 10px 20px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
}

.period-btn:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
}

.period-btn.active {
    background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
    color: white;
    box-shadow: 0 2px 8px var(--accent-glow);
}

.charts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
}

.chart-card {
    overflow: visible;
}

.chart-card-wide {
    grid-column: 1 / -1;
}

.chart-body {
    height: 300px;
    position: relative;
}

.chart-body-tall {
    height: 400px;
}

.chart-legend {
    display: flex;
    gap: 16px;
    font-size: 12px;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
}

.legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.traffic-totals {
    display: flex;
    gap: 16px;
    font-size: 13px;
    color: var(--text-secondary);
}

.traffic-totals .up {
    color: var(--success);
}

.traffic-totals .down {
    color: var(--info);
}

#nodesTableBody .node-name {
    font-weight: 600;
}

#nodesTableBody .value-highlight,
#clientsTableBody .value-highlight {
    font-weight: 600;
    color: var(--accent);
}

/* Responsive */
@media (max-width: 1200px) {
    .stats-summary-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .charts-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .stats-summary-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .period-selector {
        width: 100%;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    
    .period-btn {
        flex: 1;
        min-width: 50px;
        padding: 8px 12px;
        font-size: 13px;
    }
    
    .chart-body {
        height: 250px;
    }
    
    .chart-body-tall {
        height: 300px;
    }
    
    .traffic-totals {
        flex-direction: column;
        gap: 4px;
        font-size: 11px;
    }
}

@media (max-width: 480px) {
    .stats-summary-grid {
        grid-template-columns: 1fr;
    }
}

.clients-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    align-items: start;
}

.clients-chart-wrap {
    width: 260px;
    height: 260px;
    position: relative;
}

.clients-table-wrap .table th.text-right,
.clients-table-wrap .table td.text-right {
    text-align: right;
}

.client-color-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 8px;
    flex-shrink: 0;
}

.users-desc { font-size: 13px; margin-bottom: 12px; }
.users-actions { display: flex; align-items: center; gap: 12px; }
.users-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-secondary); cursor: pointer; }
.users-search {
    padding: 7px 12px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 13px;
    width: 180px;
}
.users-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.user-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 12px;
    white-space: nowrap;
}
.user-chip b { color: var(--text-primary); font-weight: 600; }
.user-chip small { color: var(--text-muted); font-size: 11px; }
.user-chip.chip-online { border-color: var(--success); background: var(--success-bg); color: var(--success); }
.user-chip.chip-own { border-color: var(--accent); color: var(--accent-hover); }
.user-chip.chip-background { border-style: dashed; color: var(--text-muted); background: transparent; }
.users-table td { vertical-align: middle; }
.users-table .cell-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.users-table .user-name { font-weight: 600; color: var(--text-primary); text-decoration: none; }
.users-table .user-name:hover { color: var(--accent-hover); }
.users-table .user-alias { color: var(--text-muted); font-size: 12px; margin-left: 6px; }
.users-table tr.user-off .user-name { color: var(--text-muted); }
.users-table .traffic-cell { white-space: nowrap; }
.users-matrix-wrap { overflow-x: auto; }
.users-matrix th, .users-matrix td { white-space: nowrap; text-align: right; font-size: 12.5px; padding: 8px 10px; }
.users-matrix th:first-child, .users-matrix td:first-child {
    text-align: left;
    position: sticky;
    left: 0;
    background: var(--bg-secondary);
    z-index: 1;
}
.users-matrix th small { display: block; color: var(--text-muted); font-weight: 400; }
.users-matrix td.cell-empty { color: var(--text-muted); opacity: 0.5; }
.users-matrix td.cell-online { box-shadow: inset 0 0 0 1px var(--success); }
.users-matrix .dot-online { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--success); margin-right: 5px; }
.users-matrix tfoot td { font-weight: 600; border-top: 1px solid var(--border); }

@media (max-width: 768px) {
    .clients-layout {
        grid-template-columns: 1fr;
    }
    .clients-chart-wrap {
        width: 220px;
        height: 220px;
        margin: 0 auto;
    }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
<script>
// i18n
const i18n = {
    online: <%- JSON.stringify(t('stats.online')) %>,
    nodesOnline: <%- JSON.stringify(t('stats.nodesOnline')) %>,
    upload: <%- JSON.stringify(t('stats.upload')) %>,
    download: <%- JSON.stringify(t('stats.download')) %>,
    connections: <%- JSON.stringify(t('common.connections')) %>,
    allNodes: <%- JSON.stringify(t('stats.allNodes')) %>,
    noData: <%- JSON.stringify(t('stats.noData')) %>,
    hourChange: <%- JSON.stringify(t('stats.hourChange')) %>,
    clientsUniqueUsers: <%- JSON.stringify(t('stats.uniqueUsers')) %>,
    clientsNoData: <%- JSON.stringify(t('stats.clientsNoData')) %>,
    serverCpu: <%- JSON.stringify(t('stats.serverCpu')) %>,
    serverLoad: <%- JSON.stringify(t('stats.serverLoad')) %>,
    serverMemory: <%- JSON.stringify(t('stats.serverMemory')) %>,
    serverRss: <%- JSON.stringify(t('stats.serverRss')) %>,
    serverRpm: <%- JSON.stringify(t('stats.serverRpm')) %>,
    serverDisk: <%- JSON.stringify(t('stats.serverDisk')) %>,
    serverDiskFree: <%- JSON.stringify(t('stats.serverDiskFree')) %>,
    usersNever: <%- JSON.stringify(t('stats.usersNever')) %>,
    usersNoAppPassword: <%- JSON.stringify(t('stats.usersNoAppPassword')) %>,
    usersNotLoggedIn: <%- JSON.stringify(t('stats.usersNotLoggedIn')) %>,
    usersLastSeen: <%- JSON.stringify(t('stats.usersLastSeen')) %>,
    usersOn: <%- JSON.stringify(t('stats.usersOn')) %>,
    usersDisabled: <%- JSON.stringify(t('stats.usersDisabled')) %>,
    usersSummaryOnline: <%- JSON.stringify(t('stats.usersSummaryOnline')) %>,
    usersSummaryNoClient: <%- JSON.stringify(t('stats.usersSummaryNoClient')) %>,
    usersNoActivity: <%- JSON.stringify(t('stats.usersNoActivity')) %>,
    usersTotal: <%- JSON.stringify(t('stats.usersTotal')) %>,
    usersConnections: <%- JSON.stringify(t('stats.usersConnections')) %>,
    usersConnectionsHint: <%- JSON.stringify(t('stats.usersConnectionsHint')) %>,
    usersActive: <%- JSON.stringify(t('stats.usersActive')) %>,
    usersBackgroundHint: <%- JSON.stringify(t('stats.usersBackgroundHint')) %>,
    user: <%- JSON.stringify(t('stats.user')) %>,
};

// Last fetched nodes data -- stored so metric toggle doesn't require a refetch
let _lastNodesData = null;

// Charts instances
let onlineChart = null;
let trafficChart = null;
let nodesChart = null;
let nodesTrafficChart = null;
let clientsChart = null;
let hostCpuChart = null;
let hostMemChart = null;
let hostRpmChart = null;
let hostDiskChart = null;

// Current period
let currentPeriod = '1h';

// Chart colors
const colors = {
    online: { bg: 'rgba(99, 102, 241, 0.2)', border: '#6366f1' },
    nodes: { bg: 'rgba(34, 197, 94, 0.2)', border: '#22c55e' },
    upload: { bg: 'rgba(34, 197, 94, 0.3)', border: '#22c55e' },
    download: { bg: 'rgba(59, 130, 246, 0.3)', border: '#3b82f6' },
    cpu:      { bg: 'rgba(99, 102, 241, 0.15)', border: '#6366f1' },
    load:     { bg: 'rgba(245, 158, 11, 0.0)',  border: '#f59e0b' },
    memHost:  { bg: 'rgba(139, 92, 246, 0.15)', border: '#8b5cf6' },
    memRss:   { bg: 'rgba(20, 184, 166, 0.0)',  border: '#14b8a6' },
    rpm:      { bg: 'rgba(34, 197, 94, 0.2)',   border: '#22c55e' },
    disk:     { bg: 'rgba(245, 158, 11, 0.15)', border: '#f59e0b' },
    diskFree: { bg: 'rgba(6, 182, 212, 0.0)',   border: '#06b6d4' },
    nodeColors: [
        '#6366f1', '#22c55e', '#f59e0b', '#ef4444', '#8b5cf6',
        '#ec4899', '#14b8a6', '#f97316', '#06b6d4', '#84cc16'
    ]
};

// Chart defaults
Chart.defaults.color = '#a1a1aa';
Chart.defaults.borderColor = '#27272a';
Chart.defaults.font.family = "'Inter', sans-serif";

// Initialize
document.addEventListener('DOMContentLoaded', () => {
    initCharts();
    loadData(currentPeriod);
    
    // Period selector
    document.querySelectorAll('.period-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentPeriod = btn.dataset.period;
            loadData(currentPeriod);
        });
    });
    
    // Auto-refresh every minute
    setInterval(() => loadData(currentPeriod), 60000);
});

function initCharts() {
    // Online Chart
    const onlineCtx = document.getElementById('onlineChart').getContext('2d');
    onlineChart = new Chart(onlineCtx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [{
                label: i18n.online,
                data: [],
                borderColor: colors.online.border,
                backgroundColor: colors.online.bg,
                fill: true,
                tension: 0.4,
                pointRadius: 0,
                pointHoverRadius: 6,
            }]
        },
        options: getChartOptions('online')
    });
    
    // Traffic Chart
    const trafficCtx = document.getElementById('trafficChart').getContext('2d');
    trafficChart = new Chart(trafficCtx, {
        type: 'bar',
        data: {
            labels: [],
            datasets: [
                {
                    label: i18n.upload,
                    data: [],
                    backgroundColor: colors.upload.bg,
                    borderColor: colors.upload.border,
                    borderWidth: 1,
                    borderRadius: 4,
                },
                {
                    label: i18n.download,
                    data: [],
                    backgroundColor: colors.download.bg,
                    borderColor: colors.download.border,
                    borderWidth: 1,
                    borderRadius: 4,
                }
            ]
        },
        options: getChartOptions('traffic')
    });
    
    // Nodes Online Chart
    const nodesCtx = document.getElementById('nodesChart').getContext('2d');
    nodesChart = new Chart(nodesCtx, {
        type: 'line',
        data: {
            labels: [],
            datasets: []
        },
        options: getChartOptions('nodes')
    });

    // Nodes Traffic Chart
    const nodesTrafficCtx = document.getElementById('nodesTrafficChart').getContext('2d');
    nodesTrafficChart = new Chart(nodesTrafficCtx, {
        type: 'line',
        data: {
            labels: [],
            datasets: []
        },
        options: getChartOptions('nodesTraffic')
    });

    // Host CPU + Load1 (dual axis)
    const hostCpuCtx = document.getElementById('hostCpuChart').getContext('2d');
    hostCpuChart = new Chart(hostCpuCtx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                {
