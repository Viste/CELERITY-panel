        <span class="legend-item" style="color: var(--text-muted)">Max: ${maxCpu}%</span>
        <span class="legend-item">
            <span class="legend-dot" style="background: ${colors.load.border}"></span>
            ${i18n.serverLoad}: ${Number(lastLoad).toFixed(2)}
