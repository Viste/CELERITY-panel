function updateNodesChart(data) {
    if (!data.labels || data.labels.length === 0 || !data.nodes) {
        return;
    }

    const labels = data.labels.map(l => new Date(l));

    // Online chart
    nodesChart.data.labels = labels;
    nodesChart.data.datasets = data.nodes.map((node, i) => ({
        label: node.name,
        data: node.data.map(d => d.online),
        borderColor: colors.nodeColors[i % colors.nodeColors.length],
        backgroundColor: 'transparent',
        tension: 0.4,
        pointRadius: 0,
        pointHoverRadius: 4,
    }));
    nodesChart.update('none');

    // Traffic chart
    nodesTrafficChart.data.labels = labels;
    nodesTrafficChart.data.datasets = data.nodes.map((node, i) => ({
        label: node.name,
        data: node.data.map(d => (d.tx || 0) + (d.rx || 0)),
        borderColor: colors.nodeColors[i % colors.nodeColors.length],
        backgroundColor: 'transparent',
        tension: 0.4,
        pointRadius: 0,
        pointHoverRadius: 4,
    }));
    nodesTrafficChart.options.scales.y.ticks = { callback: v => formatBytes(v) };
    nodesTrafficChart.options.plugins.tooltip.callbacks.label = ctx => `${ctx.dataset.label}: ${formatBytes(ctx.raw)}`;
    nodesTrafficChart.update('none');

    // Populate both selectors
    [document.getElementById('nodeSelector'), document.getElementById('nodeTrafficSelector')].forEach(sel => {
        if (!sel) return;
        sel.innerHTML = `<option value="all">${i18n.allNodes}</option>`;
        data.nodes.forEach((node, i) => {
            sel.innerHTML += `<option value="${i}">${node.name}</option>`;
        });
    });
}

function updateNodesTable(data) {
    const tbody = document.getElementById('nodesTableBody');
    
    if (!data.nodes || data.nodes.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">${i18n.noData}</td></tr>`;
        return;
    }
    
    tbody.innerHTML = data.nodes.map(node => {
        const onlineValues = node.data.map(d => d.online);
        const current = onlineValues[onlineValues.length - 1] || 0;
        const avg = Math.round(onlineValues.reduce((a, b) => a + b, 0) / onlineValues.length);
        const peak = Math.max(...onlineValues);
        const lastStatus = node.data[node.data.length - 1]?.status || 'offline';
        // Totals come from pre-aggregated fields; fall back to summing data array for old snapshots
        const totalTx = node.totalTx != null ? node.totalTx : node.data.reduce((s, d) => s + (d.tx || 0), 0);
        const totalRx = node.totalRx != null ? node.totalRx : node.data.reduce((s, d) => s + (d.rx || 0), 0);
        
        return `
            <tr>
                <td class="node-name">${node.name}</td>
                <td class="value-highlight">${current}</td>
                <td>${avg}</td>
                <td>${peak}</td>
                <td style="color:var(--success)">${formatBytes(totalTx)}</td>
                <td style="color:var(--accent)">${formatBytes(totalRx)}</td>
                <td>
                    <span class="status-indicator status-${lastStatus}">
                        <span class="status-dot"></span>
                        ${lastStatus}
                    </span>
                </td>
            </tr>
        `;
    }).join('');
}

function updateClientsSection(data) {
    const tbody = document.getElementById('clientsTableBody');
    const totalEl = document.getElementById('clientsTotal');

    if (!data || !data.totals || data.total === 0) {
        tbody.innerHTML = `<tr><td colspan="3" class="text-center text-muted">${i18n.clientsNoData}</td></tr>`;
        if (totalEl) totalEl.textContent = '';
        if (clientsChart) {
            clientsChart.data.labels = [];
            clientsChart.data.datasets[0].data = [];
            clientsChart.data.datasets[0].backgroundColor = [];
            clientsChart.update('none');
        }
        return;
    }

    // Sort clients by count descending, skip zeros
    const entries = Object.entries(data.totals)
        .filter(([, v]) => v > 0)
        .sort((a, b) => b[1] - a[1]);

    const chartColors = colors.nodeColors;

    // Update donut chart
    if (clientsChart) {
        clientsChart.data.labels = entries.map(([name]) => name);
        clientsChart.data.datasets[0].data = entries.map(([, v]) => v);
        clientsChart.data.datasets[0].backgroundColor = entries.map((_, i) => chartColors[i % chartColors.length]);
        clientsChart.update('none');
    }

    // Update total label
    if (totalEl) totalEl.textContent = `${data.total} ${i18n.clientsUniqueUsers}`;

    // Update table
    tbody.innerHTML = entries.map(([name, count], i) => {
        const pct = data.total > 0 ? ((count / data.total) * 100).toFixed(1) : '0.0';
        const color = chartColors[i % chartColors.length];
        return `
            <tr>
                <td><span class="client-color-dot" style="background:${color}"></span>${name}</td>
                <td class="text-right value-highlight">${count}</td>
                <td class="text-right text-muted">${pct}%</td>
            </tr>
        `;
    }).join('');
}

async function updateTrend() {
    try {
        const res = await fetch('/panel/stats/api/summary', { credentials: 'include' });
        const data = await res.json();
        
        const trend = data.trends?.hourly || 0;
        const trendEl = document.getElementById('onlineTrend');
        
        if (trend > 0) {
            trendEl.innerHTML = `<span style="color: var(--success)"><i class="ti ti-trending-up"></i> ${trend}%</span>`;
        } else if (trend < 0) {
            trendEl.innerHTML = `<span style="color: var(--danger)"><i class="ti ti-trending-down"></i> ${Math.abs(trend)}%</span>`;
        } else {
            trendEl.textContent = '—';
        }
        
        document.getElementById('currentOnline').textContent = data.current?.online || 0;
        
    } catch (e) {
        console.error('Failed to update trend:', e);
    }
}

// ---- Users: who is where, with which app ----
let _usersData = null;

// Our own apps, Potato and Orbita, are highlighted among the clients.
const isOwnApp = key => /^(potato|orbita)(-|$)/.test(key);

const CLIENT_LABELS = {
    'potato-android': 'Potato Android', 'potato-ios': 'Potato iOS', potato: 'Potato',
    'orbita-mac': 'Orbita Mac', 'orbita-windows': 'Orbita Windows', orbita: 'Orbita',
    happ: 'Happ', incy: 'Incy', hiddify: 'Hiddify', nekobox: 'NekoBox', singbox: 'sing-box',
    v2rayng: 'v2rayNG', shadowrocket: 'Shadowrocket', streisand: 'Streisand', clash: 'Clash',
    quantumult: 'Quantumult', other: 'other',
};

function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}

const _relativeTime = new Intl.RelativeTimeFormat(document.documentElement.lang || 'en', { numeric: 'auto', style: 'short' });
function timeAgo(value) {
    if (!value) return '';
    const seconds = Math.round((new Date(value).getTime() - Date.now()) / 1000);
    const abs = Math.abs(seconds);
    if (abs < 60) return _relativeTime.format(Math.trunc(seconds), 'second');
    if (abs < 3600) return _relativeTime.format(Math.trunc(seconds / 60), 'minute');
    if (abs < 86400) return _relativeTime.format(Math.trunc(seconds / 3600), 'hour');
    return _relativeTime.format(Math.trunc(seconds / 86400), 'day');
}

async function loadUsers(period) {
    try {
        const data = await fetch(`/panel/stats/api/users?period=${period}`, { credentials: 'include' }).then(r => r.json());
        if (data.error) throw new Error(data.error);
        _usersData = data;
        renderUsers();
    } catch (error) {
        console.error('Failed to load user stats:', error);
        document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" class="text-center text-muted">${i18n.noData}</td></tr>`;
    }
}

function renderUsers() {
    const data = _usersData;
    if (!data) return;
    const nodeById = Object.fromEntries(data.nodes.map(n => [n.id, n]));
    const nodeLabel = id => { const n = nodeById[id]; return n ? `${n.flag ? n.flag + ' ' : ''}${n.name}` : '?'; };
    const query = (document.getElementById('usersSearch').value || '').trim().toLowerCase();
    const onlineOnly = document.getElementById('usersOnlineOnly').checked;
    const users = data.users.filter(u =>
        (!onlineOnly || u.online.length > 0)
        && (!query || u.userId.toLowerCase().includes(query) || (u.username || '').toLowerCase().includes(query)));

    // summary chips
    const chips = [
        `<span class="user-chip chip-online"><b>${data.summary.online}</b> / ${data.summary.users} ${escapeHtml(i18n.usersSummaryOnline)}</span>`,
        `<span class="user-chip" title="${escapeHtml(i18n.usersConnectionsHint)}">${escapeHtml(i18n.usersConnections)} <b>${data.summary.connections}</b> · ${escapeHtml(i18n.usersActive)} <b>${data.summary.activeConnections}</b></span>`,
    ];
    Object.entries(data.summary.clients).sort((a, b) => b[1] - a[1]).forEach(([key, count]) => {
        chips.push(`<span class="user-chip ${isOwnApp(key) ? 'chip-own' : ''}">${escapeHtml(CLIENT_LABELS[key] || key)} <b>${count}</b></span>`);
    });
    const noClient = data.summary.users - data.summary.withClient;
    if (noClient > 0) chips.push(`<span class="user-chip">${escapeHtml(i18n.usersSummaryNoClient)} <b>${noClient}</b></span>`);
    document.getElementById('usersSummary').innerHTML = chips.join('');

    // table
    const tbody = document.getElementById('usersTableBody');
    if (users.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">${i18n.noData}</td></tr>`;
    } else {
        tbody.innerHTML = users.map(u => {
            const alias = u.username && u.username !== u.userId ? `<span class="user-alias">${escapeHtml(u.username)}</span>` : '';
            const off = u.enabled ? '' : ` <span class="user-chip">${escapeHtml(i18n.usersDisabled)}</span>`;
            let where;
            if (u.online.length > 0) {
                where = `<div class="cell-chips">${u.online.map(o => o.background
                    ? `<span class="user-chip chip-background" title="${escapeHtml(i18n.usersBackgroundHint)}">${escapeHtml(nodeLabel(o.node))}</span>`
                    : `<span class="user-chip chip-online"${o.delta != null ? ` title="${escapeHtml(formatBytes(o.delta))} / 5 min"` : ''}>${escapeHtml(nodeLabel(o.node))}</span>`).join('')}</div>`;
            } else {
                const last = Object.entries(u.byNode).filter(([, c]) => c.lastSeen).sort((a, b) => new Date(b[1].lastSeen) - new Date(a[1].lastSeen))[0];
                where = last
                    ? `<span class="text-muted">${escapeHtml(i18n.usersLastSeen)} ${escapeHtml(timeAgo(last[1].lastSeen))} ${escapeHtml(i18n.usersOn)} ${escapeHtml(nodeLabel(last[0]))}</span>`
                    : '<span class="text-muted">—</span>';
            }
            const apps = u.clients.length
                ? `<div class="cell-chips">${u.clients.map(c => `<span class="user-chip ${isOwnApp(c.key) ? 'chip-own' : ''}">${escapeHtml(CLIENT_LABELS[c.key] || c.key)} <small>${escapeHtml(timeAgo(c.at))}</small></span>`).join('')}</div>`
                : '<span class="text-muted">—</span>';
            const fetched = u.lastFetchAt ? escapeHtml(timeAgo(u.lastFetchAt)) : `<span class="text-muted">${escapeHtml(i18n.usersNever)}</span>`;
            const login = u.appAt
                ? escapeHtml(timeAgo(u.appAt)) + (u.appKey ? ` <small class="text-muted">${escapeHtml(CLIENT_LABELS[u.appKey] || u.appKey)}</small>` : '')
                : `<span class="text-muted">${escapeHtml(u.hasAppPassword ? i18n.usersNotLoggedIn : i18n.usersNoAppPassword)}</span>`;
            const traffic = (u.traffic.tx || u.traffic.rx)
                ? `<span style="color:var(--success)">↑ ${formatBytes(u.traffic.tx)}</span> <span style="color:var(--accent)">↓ ${formatBytes(u.traffic.rx)}</span>`
                : '<span class="text-muted">—</span>';
            return `
                <tr class="${u.enabled ? '' : 'user-off'}">
                    <td><a class="user-name" href="/panel/users/${encodeURIComponent(u.userId)}">${escapeHtml(u.userId)}</a>${alias}${off}</td>
                    <td>${where}</td>
                    <td>${apps}</td>
                    <td>${fetched}</td>
                    <td>${login}</td>
                    <td class="text-right traffic-cell">${traffic}</td>
                </tr>`;
        }).join('');
    }

    renderUsersMatrix(data, users);
}

function renderUsersMatrix(data, users) {
    const table = document.getElementById('usersMatrix');
    const active = users.filter(u => Object.keys(u.byNode).length > 0);
    if (data.nodes.length === 0 || active.length === 0) {
        table.innerHTML = `<tbody><tr><td class="text-center text-muted">${escapeHtml(i18n.usersNoActivity)}</td></tr></tbody>`;
        return;
    }
    let max = 1;
    active.forEach(u => Object.values(u.byNode).forEach(c => { max = Math.max(max, c.tx + c.rx); }));
    const onlineByNode = data.summary.onlineByNode || {};
    const head = `<thead><tr><th>${escapeHtml(i18n.user)}</th>${data.nodes.map(n =>
        `<th title="${escapeHtml(n.type)}">${escapeHtml(n.flag || '')} ${escapeHtml(n.name)}<small>${(onlineByNode[n.id] || []).length} ${escapeHtml(i18n.usersSummaryOnline)}</small></th>`).join('')}</tr></thead>`;
    const totals = Object.fromEntries(data.nodes.map(n => [n.id, 0]));
    const body = active.map(u => {
        const cells = data.nodes.map(n => {
            const c = u.byNode[n.id];
            const total = c ? c.tx + c.rx : 0;
            const live = u.online.find(o => o.node === n.id);
            if (!c || (total === 0 && !live)) return '<td class="cell-empty">·</td>';
            totals[n.id] += total;
            const online = !!live && !live.background;
            // log scale: a few megabytes should still be visible next to gigabytes
            const alpha = total > 0 ? (0.08 + 0.42 * Math.log1p(total) / Math.log1p(max)).toFixed(2) : 0;
            const title = `↑ ${formatBytes(c.tx)}  ↓ ${formatBytes(c.rx)}${c.lastSeen ? '  ·  ' + timeAgo(c.lastSeen) : ''}`;
            return `<td class="${online ? 'cell-online' : ''}" style="background:rgba(var(--accent-rgb), ${alpha})" title="${escapeHtml(title)}">${online ? '<span class="dot-online"></span>' : ''}${formatBytes(total)}</td>`;
        }).join('');
        return `<tr><td>${escapeHtml(u.userId)}</td>${cells}</tr>`;
    }).join('');
    const foot = `<tfoot><tr><td>${escapeHtml(i18n.usersTotal)}</td>${data.nodes.map(n => `<td>${totals[n.id] ? formatBytes(totals[n.id]) : '·'}</td>`).join('')}</tr></tfoot>`;
    table.innerHTML = head + `<tbody>${body}</tbody>` + foot;
}

document.getElementById('usersSearch')?.addEventListener('input', renderUsers);
document.getElementById('usersOnlineOnly')?.addEventListener('change', renderUsers);

function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function filterChart(chart, allDatasets, selectedIdx) {
    if (selectedIdx === 'all') {
        chart.data.datasets = allDatasets;
    } else {
        const i = parseInt(selectedIdx);
        chart.data.datasets = allDatasets[i] ? [allDatasets[i]] : [];
    }
    chart.update('none');
}

document.getElementById('nodeSelector')?.addEventListener('change', function() {
    if (!_lastNodesData) return;
    const all = _lastNodesData.nodes.map((node, i) => ({
        label: node.name,
        data: node.data.map(d => d.online),
        borderColor: colors.nodeColors[i % colors.nodeColors.length],
        backgroundColor: 'transparent',
        tension: 0.4, pointRadius: 0, pointHoverRadius: 4,
    }));
    filterChart(nodesChart, all, this.value);
});

document.getElementById('nodeTrafficSelector')?.addEventListener('change', function() {
    if (!_lastNodesData) return;
    const all = _lastNodesData.nodes.map((node, i) => ({
        label: node.name,
        data: node.data.map(d => (d.tx || 0) + (d.rx || 0)),
        borderColor: colors.nodeColors[i % colors.nodeColors.length],
        backgroundColor: 'transparent',
        tension: 0.4, pointRadius: 0, pointHoverRadius: 4,
    }));
    filterChart(nodesTrafficChart, all, this.value);
});

</script>

