    const labels = data.labels.map(l => new Date(l));
    const ds = data.datasets || {};

    // CPU + Load
    hostCpuChart.data.labels = labels;
    hostCpuChart.data.datasets[0].data = ds.cpuPct || [];
    hostCpuChart.data.datasets[1].data = ds.load1 || [];
    hostCpuChart.update('none');

    const lastCpu  = (ds.cpuPct || []).slice(-1)[0] ?? 0;
    const maxCpu   = ds.cpuPct && ds.cpuPct.length ? Math.max(...ds.cpuPct) : 0;
    const lastLoad = (ds.load1 || []).slice(-1)[0] ?? 0;
    document.getElementById('hostCpuLegend').innerHTML = `
        <span class="legend-item">
            <span class="legend-dot" style="background: ${colors.cpu.border}"></span>
            ${i18n.serverCpu}: ${lastCpu}%
