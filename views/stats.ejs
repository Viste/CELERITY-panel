    hostRpmChart.data.datasets[0].data = ds.rpm || [];
    hostRpmChart.update('none');

    const lastRpm = (ds.rpm || []).slice(-1)[0] ?? 0;
    const maxRpm  = ds.rpm && ds.rpm.length ? Math.max(...ds.rpm) : 0;
    document.getElementById('hostRpmLegend').innerHTML = `
        <span class="legend-item">
            <span class="legend-dot" style="background: ${colors.rpm.border}"></span>
            ${i18n.serverRpm}: ${lastRpm}
        </span>
        <span class="legend-item" style="color: var(--text-muted)">Max: ${maxRpm}</span>
